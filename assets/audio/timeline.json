    },
    {
      "id": "14_boy_how_pie",
      "scene": "08",
      "role": "boy",
      "text": "Як пиріг?",
      "start_sec": 53.127,
      "end_sec": 54.407,
      "dry_end_sec": 54.407,
      "duration_sec": 1.28,
      "audio_file": "assets/audio/lines/14_boy_how_pie.wav",
      "dry_audio_file": "assets/audio/lines_dry/14_boy_how_pie.wav"
    },
    {
      "id": "15_narrator_dove_nod",
      "scene": "08",
      "role": "narrator",
      "text": "А голуб стояв і лише головою кивав.",
      "start_sec": 55.057,
      "end_sec": 58.017,
      "dry_end_sec": 58.017,
      "duration_sec": 2.96,
      "audio_file": "assets/audio/lines/15_narrator_dove_nod.wav",
      "dry_audio_file": "assets/audio/lines_dry/15_narrator_dove_nod.wav"
    },
    {
      "id": "16_boy_ask_mom",
      "scene": "09",
      "role": "boy",
      "text": "Хм, пиріг... Мамо, мамо, чому голуб сказав, що він мій пиріг? Як це?",
      "start_sec": 58.917,
      "end_sec": 65.7488,
      "dry_end_sec": 65.7488,
      "duration_sec": 6.8318,
      "audio_file": "assets/audio/lines/16_boy_ask_mom.wav",
      "dry_audio_file": "assets/audio/lines_dry/16_boy_ask_mom.wav"
    },
    {
      "id": "17_narrator_mom_smile",
      "scene": "10",
      "role": "narrator",
      "text": "Мама лише тихо посміхнулась і погладила сина по голові:",
      "start_sec": 66.4988,
      "end_sec": 70.4193,
      "dry_end_sec": 70.4193,
      "duration_sec": 3.9205,
      "audio_file": "assets/audio/lines/17_narrator_mom_smile.wav",
      "dry_audio_file": "assets/audio/lines_dry/17_narrator_mom_smile.wav"
    },
    {
      "id": "18_mom_soul",
      "scene": "10",
      "role": "mom",
      "text": "Так, серденько, він — твій пиріг, і твоє дитинство, і твоя Душа...",
      "start_sec": 70.9693,
      "end_sec": 76.3906,
      "dry_end_sec": 76.3906,
      "duration_sec": 5.4213,
      "audio_file": "assets/audio/lines/18_mom_soul.wav",
