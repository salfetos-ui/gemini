    },
    {
      "id": "12_boy_pie_q1",
      "scene": "08",
      "role": "boy",
      "text": "Пиріг?",
      "start_sec": 50.384,
      "end_sec": 51.3423,
      "dry_end_sec": 51.3422,
      "duration_sec": 0.9582,
      "audio_file": "assets/audio/lines/12_boy_pie_q1.wav",
