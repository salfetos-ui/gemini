  "lines": [
    {
      "id": "01_narrator_title",
      "scene": "01",
      "role": "narrator",
      "text": "Казка Пирожок.",
      "start_sec": 1.8,
      "end_sec": 3.4575,
      "duration_sec": 1.6575,
      "audio_file": "assets/audio/lines/01_narrator_title.wav"
    },
    {
      "id": "02_boy_smell",
      "scene": "02",
      "role": "boy",
      "text": "Що це так пахне, мамо?!",
      "start_sec": 4.8575,
      "end_sec": 6.808,
      "duration_sec": 1.9505,
      "audio_file": "assets/audio/lines/02_boy_smell.wav"
    },
    {
      "id": "03_narrator_ran_in",
      "scene": "02",
      "role": "narrator",
      "text": "Хлопчик забіг додому і з порогу вчув смак малинового варення. А він так полюбляв це малинове варення.",
      "start_sec": 7.358,
      "end_sec": 17.4355,
      "duration_sec": 10.0775,
      "audio_file": "assets/audio/lines/03_narrator_ran_in.wav"
    },
    {
      "id": "04_mom_come_in",
      "scene": "03",
      "role": "mom",
      "text": "Заходь, сину,",
      "start_sec": 18.1355,
      "end_sec": 19.1076,
      "duration_sec": 0.9721,
      "audio_file": "assets/audio/lines/04_mom_come_in.wav"
    },
    {
      "id": "05_narrator_mom_ran",
      "scene": "03",
      "role": "narrator",
      "text": "вибігла назустріч мама,",
      "start_sec": 19.3576,
      "end_sec": 21.3545,
      "duration_sec": 1.9969,
      "audio_file": "assets/audio/lines/05_narrator_mom_ran.wav"
    },
    {
      "id": "06_mom_pie_ready",
      "scene": "03",
      "role": "mom",
      "text": "пиріг допікається, будемо куштувати.",
      "start_sec": 21.6045,
      "end_sec": 24.2475,
      "duration_sec": 2.643,
      "audio_file": "assets/audio/lines/06_mom_pie_ready.wav"
    },
    {
      "id": "07_narrator_saw_bird",
      "scene": "04",
      "role": "narrator",
      "text": "Пішов хлопчик на кухню і побачив птаха на вікні. Це був голуб білий.",
      "start_sec": 25.1975,
      "end_sec": 34.2069,
      "duration_sec": 9.0094,
      "audio_file": "assets/audio/lines/07_narrator_saw_bird.wav"
    },
    {
      "id": "08_narrator_sky_eyes",
      "scene": "05",
      "role": "narrator",
      "text": "Він дивився на нього такими прозорими очима, як небо. І розплився простір тихий і так добре стало на душі.",
      "start_sec": 35.0069,
      "end_sec": 45.5023,
      "duration_sec": 10.4954,
      "audio_file": "assets/audio/lines/08_narrator_sky_eyes.wav"
    },
    {
      "id": "09_boy_who",
      "scene": "06",
      "role": "boy",
      "text": "Хто ти?",
      "start_sec": 46.6023,
      "end_sec": 47.3454,
      "duration_sec": 0.743,
      "audio_file": "assets/audio/lines/09_boy_who.wav"
    },
    {
      "id": "10_narrator_asked",
      "scene": "06",
      "role": "narrator",
      "text": "спитав хлопчик у Голуба.",
      "start_sec": 47.6454,
      "end_sec": 50.246,
      "duration_sec": 2.6006,
      "audio_file": "assets/audio/lines/10_narrator_asked.wav"
    },
    {
      "id": "11_dove_messenger",
      "scene": "07",
      "role": "dove",
      "text": "Я — посланець, я приношу радість і сміх, я — велич твоя і твій пиріг.",
      "start_sec": 51.046,
      "end_sec": 56.806,
      "duration_sec": 5.76,
      "audio_file": "assets/audio/lines/11_dove_messenger.wav"
    },
    {
      "id": "12_boy_pie_q1",
      "scene": "08",
      "role": "boy",
      "text": "Пиріг?",
      "start_sec": 57.806,
      "end_sec": 58.389,
      "duration_sec": 0.583,
      "audio_file": "assets/audio/lines/12_boy_pie_q1.wav"
    },
    {
      "id": "13_narrator_surprised",
      "scene": "08",
      "role": "narrator",
      "text": "здивувався хлопчик.",
      "start_sec": 58.639,
      "end_sec": 60.474,
      "duration_sec": 1.8349,
      "audio_file": "assets/audio/lines/13_narrator_surprised.wav"
    },
    {
      "id": "14_boy_how_pie",
      "scene": "08",
      "role": "boy",
      "text": "Як пиріг?",
      "start_sec": 60.724,
      "end_sec": 61.6641,
      "duration_sec": 0.9401,
      "audio_file": "assets/audio/lines/14_boy_how_pie.wav"
    },
    {
      "id": "15_narrator_dove_nod",
      "scene": "08",
      "role": "narrator",
      "text": "А голуб стояв і лише головою кивав.",
      "start_sec": 62.4141,
      "end_sec": 66.4346,
      "duration_sec": 4.0205,
      "audio_file": "assets/audio/lines/15_narrator_dove_nod.wav"
    },
    {
      "id": "16_boy_ask_mom",
      "scene": "09",
      "role": "boy",
      "text": "Хм, пиріг... Мамо, мамо, чому голуб сказав, що він мій пиріг? Як це?",
      "start_sec": 67.4846,
      "end_sec": 74.1148,
      "duration_sec": 6.6302,
      "audio_file": "assets/audio/lines/16_boy_ask_mom.wav"
    },
    {
      "id": "17_narrator_mom_smile",
      "scene": "10",
      "role": "narrator",
      "text": "Мама лише тихо посміхнулась і погладила сина по голові:",
      "start_sec": 74.9648,
      "end_sec": 81.1766,
      "duration_sec": 6.2119,
      "audio_file": "assets/audio/lines/17_narrator_mom_smile.wav"
    },
    {
      "id": "18_mom_soul",
      "scene": "10",
      "role": "mom",
      "text": "Так, серденько, він — твій пиріг, і твоє дитинство, і твоя Душа...",
      "start_sec": 81.8266,
      "end_sec": 86.6665,
      "duration_sec": 4.8399,
      "audio_file": "assets/audio/lines/18_mom_soul.wav"
    },
    {
      "id": "19_narrator_understood",
      "scene": "10",
      "role": "narrator",
      "text": "Хлопчик подивився на голуба і, наче, все зрозумів...",
      "start_sec": 87.9165,
      "end_sec": 94.0211,
      "duration_sec": 6.1046,
      "audio_file": "assets/audio/lines/19_narrator_understood.wav"
    }
  ],
