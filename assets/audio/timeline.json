    {
      "id": "02_boy_smell",
      "scene": "02",
      "role": "boy",
      "text": "Що це так пахне, мамо?!",
      "start_sec": 4.5046,
      "end_sec": 6.5846,
      "dry_end_sec": 6.5846,
      "duration_sec": 2.08,
      "audio_file": "assets/audio/lines/02_boy_smell.wav",
      "dry_audio_file": "assets/audio/lines_dry/02_boy_smell.wav"
    },
    {
      "id": "03_narrator_ran_in",
      "scene": "02",
      "role": "narrator",
      "text": "Хлопчик забіг додому і з порогу вчув смак малинового варення. А він так полюбляв це малинове варення.",
      "start_sec": 7.0046,
      "end_sec": 14.5286,
      "dry_end_sec": 14.5286,
      "duration_sec": 7.524,
      "audio_file": "assets/audio/lines/03_narrator_ran_in.wav",
      "dry_audio_file": "assets/audio/lines_dry/03_narrator_ran_in.wav"
    },
    {
      "id": "04_mom_come_in",
      "scene": "03",
      "role": "mom",
      "text": "Заходь, сину,",
      "start_sec": 15.1786,
      "end_sec": 16.5386,
      "dry_end_sec": 16.5386,
      "duration_sec": 1.36,
      "audio_file": "assets/audio/lines/04_mom_come_in.wav",
      "dry_audio_file": "assets/audio/lines_dry/04_mom_come_in.wav"
    },
    {
      "id": "05_narrator_mom_ran",
      "scene": "03",
      "role": "narrator",
      "text": "вибігла назустріч мама,",
      "start_sec": 16.6986,
      "end_sec": 18.3786,
      "dry_end_sec": 18.3786,
      "duration_sec": 1.68,
      "audio_file": "assets/audio/lines/05_narrator_mom_ran.wav",
      "dry_audio_file": "assets/audio/lines_dry/05_narrator_mom_ran.wav"
    },
    {
      "id": "06_mom_pie_ready",
      "scene": "03",
      "role": "mom",
      "text": "пиріг допікається, будемо куштувати.",
      "start_sec": 18.5186,
      "end_sec": 21.1586,
      "dry_end_sec": 21.1586,
      "duration_sec": 2.64,
      "audio_file": "assets/audio/lines/06_mom_pie_ready.wav",
      "dry_audio_file": "assets/audio/lines_dry/06_mom_pie_ready.wav"
    },
    {
      "id": "07_narrator_saw_bird",
      "scene": "04",
      "role": "narrator",
      "text": "Пішов хлопчик на кухню і побачив птаха на вікні. Це був голуб білий.",
      "start_sec": 22.0086,
      "end_sec": 27.1455,
      "dry_end_sec": 27.1455,
      "duration_sec": 5.1369,
      "audio_file": "assets/audio/lines/07_narrator_saw_bird.wav",
      "dry_audio_file": "assets/audio/lines_dry/07_narrator_saw_bird.wav"
    },
    {
      "id": "08_narrator_sky_eyes",
      "scene": "05",
      "role": "narrator",
      "text": "Він дивився на нього такими прозорими очима, як небо. І розплився простір тихий і так добре стало на душі.",
      "start_sec": 27.8655,
      "end_sec": 36.744,
      "dry_end_sec": 36.744,
      "duration_sec": 8.8785,
      "audio_file": "assets/audio/lines/08_narrator_sky_eyes.wav",
      "dry_audio_file": "assets/audio/lines_dry/08_narrator_sky_eyes.wav"
    },
    {
      "id": "09_boy_who",
      "scene": "06",
      "role": "boy",
      "text": "Хто ти?",
      "start_sec": 37.694,
      "end_sec": 38.654,
      "dry_end_sec": 38.654,
      "duration_sec": 0.96,
      "audio_file": "assets/audio/lines/09_boy_who.wav",
      "dry_audio_file": "assets/audio/lines_dry/09_boy_who.wav"
    },
    {
      "id": "10_narrator_asked",
      "scene": "06",
      "role": "narrator",
      "text": "спитав хлопчик у Голуба.",
      "start_sec": 38.834,
      "end_sec": 40.674,
      "dry_end_sec": 40.674,
      "duration_sec": 1.84,
      "audio_file": "assets/audio/lines/10_narrator_asked.wav",
      "dry_audio_file": "assets/audio/lines_dry/10_narrator_asked.wav"
    },
    {
      "id": "11_dove_messenger",
      "scene": "07",
      "role": "dove",
      "text": "Я — посланець, я приношу радість і сміх, я — велич твоя і твій пиріг.",
      "start_sec": 41.394,
      "end_sec": 50.204,
      "dry_end_sec": 49.154,
      "duration_sec": 8.81,
      "audio_file": "assets/audio/lines/11_dove_messenger.wav",
